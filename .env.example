NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SEO_INDEXING=true

# MongoDB replica set or Atlas URI is required for transactions at checkout
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-at-least-32-random-characters

# Cloudinary (server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (server only; Key ID is sent to the browser only to open Checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# Store defaults used before database settings are configured
ENABLE_COD=true
SHIPPING_FEE=199
FREE_SHIPPING_THRESHOLD=25000

# Optional seed account password; seed skips the demo customer when empty
DEMO_CUSTOMER_PASSWORD=
